{
  "name": "euclidraw-copilot-extension",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/plugin.test.mjs test/manifest.test.mjs",
    "check:dist": "pnpm build && git diff --exit-code -- dist/plugin.js alid.extension.json"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  }
}
